{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "detail": "Build the plugin frontend",
            "type": "shell",
            "command": "pnpm build",
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$tsc"]
        },
        {
            "label": "deploy",
            "detail": "Build and deploy the plugin to the deck configured in deck.json",
            "type": "shell",
            "command": "pnpm deck",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "deploy (watch)",
            "detail": "Rebuild and redeploy on every change",
            "type": "shell",
            "command": "pnpm deck:watch",
            "isBackground": true,
            "group": "build",
            "problemMatcher": []
        }
    ]
}
