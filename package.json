{
    "name": "steamdeck-discord-status",
    "version": "1.6.0",
    "description": "Decky plugin to update Discord's Rich Presence status with whatever you are currently playing",
    "type": "module",
    "scripts": {
        "build": "shx rm -rf dist && rollup -c",
        "watch": "rollup -c -w",
        "deck": "node scripts/deploy.mjs",
        "deck:watch": "node scripts/deploy.mjs --watch",
        "zip": "node scripts/deploy.mjs --zip --no-deploy",
        "test": "echo \"Error: no test specified\" && exit 1"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/andrewburgess/steamdeck-discord-status.git"
    },
    "keywords": [
        "decky",
        "plugin",
        "steam-deck",
        "deck",
        "discord"
    ],
    "author": "Andrew Burgess <andrew@andrewburgess.io>",
    "license": "BSD-3-Clause",
    "bugs": {
        "url": "https://github.com/andrewburgess/steamdeck-discord-status/issues"
    },
    "homepage": "https://github.com/andrewburgess/steamdeck-discord-status#readme",
    "devDependencies": {
        "@decky/rollup": "^1.0.2",
        "@decky/ui": "^4.12.0",
        "@types/react": "19.2.17",
        "@types/react-dom": "19.2.3",
        "@types/webpack": "^5.28.5",
        "rollup": "^4.62.2",
        "shx": "^0.4.0",
        "typescript": "^7.0.2"
    },
    "dependencies": {
        "@decky/api": "^1.1.3",
        "eventemitter3": "^5.0.4",
        "react-icons": "^5.7.0",
        "tslib": "^2.7.0"
    },
    "pnpm": {
        "peerDependencyRules": {
            "ignoreMissing": [
                "react",
                "react-dom"
            ]
        }
    }
}
